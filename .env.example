# ============================================================
# HydraWeb environment template. Copy to `.env` and fill in.
# ============================================================

# --- API ---
ENVIRONMENT=development
API_URL=http://localhost:8011
FRONTEND_URL=http://localhost:3100
PLATFORM_DOMAIN=myplatform.dev
DATABASE_URL=postgresql+asyncpg://hydraweb:hydraweb@localhost:5432/hydraweb
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
AUTO_VERIFY_EMAIL=true
CORS_ORIGINS=http://localhost:3100

# Admin emails (comma-separated) become role=admin
ADMIN_EMAILS=admin@myplatform.dev

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000
LLM_CACHE_TTL=3600
LLM_CONTEXT_WINDOW=32000
# Set true to use the built-in sample generator (no API key needed)
LLM_MOCK=false

# --- SMTP (optional; leave empty to auto-verify and log emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HydraWeb <no-reply@myplatform.dev>

# --- OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (test keys from https://dashboard.stripe.com/test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Replace with your real Stripe Price IDs:
STRIPE_PRICE_FREE=prod_free
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_ent_monthly
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_ent_annual

# --- Limits ---
FREE_PROJECT_LIMIT=1
PRO_PROJECT_LIMIT=10
ENTERPRISE_PROJECT_LIMIT=100000
FREE_RATE_LIMIT=100
PRO_RATE_LIMIT=300
ENTERPRISE_RATE_LIMIT=1000
RATE_LIMIT_ENABLED=true

# --- Storage ---
STORAGE_DIR=storage

# --- Web (Next.js) ---
API_URL=http://localhost:8011
